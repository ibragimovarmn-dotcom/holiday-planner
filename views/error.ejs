<%- include('partials/header') %>

<section class="card error-page">
  <i class="bi bi-exclamation-triangle error-icon" aria-hidden="true"></i>
  <div class="error-code"><%= status %></div>
  <h1>Oops!</h1>
  <!-- Only the friendly message - never the stack trace -->
  <p><%= message %></p>
  <a href="/" class="button-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to search</a>
</section>

<%- include('partials/footer') %>